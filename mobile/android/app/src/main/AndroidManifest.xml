<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:label="AI Defense Arena" android:theme="@style/AppTheme" android:allowBackup="false" android:enableOnBackInvokedCallback="false" android:usesCleartextTraffic="false">
        <activity android:name=".ArenaActivity" android:exported="true" android:launchMode="singleTask" android:configChanges="orientation|screenSize|keyboardHidden" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="defensearena" android:host="auth" />
            </intent-filter>
        </activity>
    </application>
</manifest>
